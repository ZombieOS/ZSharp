zsharp = type.script

noticed room Game[] (
 import ZSharp.Achievements():
 noticed brain AwardTest[DR] (
  ZSharp.Achievement.Award.TEST_GAME:
 )
 noticed brain Start[] (
  Print("game start ran"):
  Print("mouse edge properties resolved: " + input.mouse.leftPressed + " " + input.mouse.leftReleased + " " + input.mouse.rightPressed + " " + input.mouse.rightReleased):
  if[input.key.a == alive] (
   TestBlock.color.set: #00E5FF:
  ) else (
   TestBlock.color.set: #FF2A72:
  )
  if[input.key.rarrow == alive or input.key.fn1 == alive] (
   number.set:TestBlock.positionX = TestBlock.positionX + 1:
  ) else (
  )
 )
 noticed brain ButtonClick[DR] (
  Print("game button clicked"):
 )
)
