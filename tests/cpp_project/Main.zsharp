  if[Third == 3] (
   Print("C++ shutdown state retained"):
  ) else (
   Print("C++ shutdown state lost"):
  )
 )

 noticed brain Start[] (
  text Greeting = Function.call(cpp:Cpp.Utilities:greeting["Tester"]):
