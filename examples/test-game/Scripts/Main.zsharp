zsharp = type.script

noticed room GameLogic[] (
 import zsharp_game_runtime_test.game.scene():
 noticed brain Start[] (
  Print("Z# game test started - A/D or arrows move, Space jumps, E changes scene"):
  loop (
   if[input.key.a == alive or input.key.larrow == alive] (
    Player.velocityX.set: -390:
    Player.color.set: #00E5FF:
   ) else (
    if[input.key.d == alive or input.key.rarrow == alive] (
     Player.velocityX.set: 390:
     Player.color.set: #FF2A72:
    ) else (
     Player.velocityX.set: 0:
     Player.color.set: #FF2A72:
    )
   )
   if[input.key.space == alive and Player.grounded == alive] (
    Player.velocityY.set: 680:
   ) else (
   )
   number.set:Player.rotation = Player.rotation + 1:
   if[input.key.e == alive] (
    if[Game.scene == "Main"] (
     Game.scene.set: Gallery:
    ) else (
     Game.scene.set: Main:
    )
    wait(250ms):
   ) else (
   )
   wait(16ms):
  )
 )
)
