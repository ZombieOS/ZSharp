zsharp = type.script:window

noticed Window Startup[] (
 import ZSharp.Window.*():
 import zsharp_language_test.PythonTest():
 import zsharp_language_test.JavaScriptTest():
 import zsharp_language_test.LuaTest():

 noticed design Design[] (
  title: "Z# Language Test":
  width: 720px:
  height: 420px:
  scalable: alive:
  background: #08080B:
 )

 noticed text[header] Heading[] (
  content: "Z# Language Test - Python • JavaScript • Lua":
  color: #FFFFFF:
 width: 600px:
 height: 50px:
  locationX: 0px:
  locationY: 125px:
 )

 noticed button RunJavaScript[] (
  text: "Run JavaScript":
  textColor: #FFFFFF:
  buttonColor: #2879D0:
  width: 180px:
  height: 42px:
  locationX: 0px:
  locationY: -15px:
  Click[
   left: [JavaScriptTest:JavaScriptTest:Run]:
   right: []:
  ]:
 )

 noticed button RunLua[] (
  text: "Run Lua":
  textColor: #FFFFFF:
  buttonColor: #2C2D72:
  width: 180px:
  height: 42px:
  locationX: 200px:
  locationY: -15px:
  Click[
   left: [LuaTest:LuaTest:Run]:
   right: []:
  ]:
 )

 noticed textInput Name[] (
  display: "Enter a name":
  type: text:
  width: 360px:
  height: 42px:
  locationX: 0px:
  locationY: 50px:
 )

 noticed button RunPython[] (
  text: "Run Python":
  textColor: #FFFFFF:
 buttonColor: #6F42E8:
 width: 180px:
 height: 42px:
  locationX: -200px:
  locationY: -15px:
  Click[
   left: [PythonTest:PythonTest:Run]:
   right: []:
  ]:
 )

 noticed text[subheader] Result[] (
  content: "Choose a language to test.":
  color: #FFFFFF:
  width: 600px:
  height: 70px:
  locationX: 0px:
  locationY: -100px:
 )
)
