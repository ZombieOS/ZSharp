zsharp = type.script

noticed room PythonTest[] (
 import zsharp_language_test.Startup():
 import py:zsharp_language_test.Python.Utilities():

 noticed brain Start[] (
 )

 noticed brain Run[] (
  text Message =
   Function.call(py:Python.Utilities:greet [Startup.Name.contents]):
  number Answer =
   Function.call(py:Python.Utilities:add [20, 22]):
  text Ready = "dead":
  if[Function.call(py:Python.Utilities:is_ready [])] (
   Ready = "alive":
  ) else (
  )

  Startup.Result.content.set:
   (Message + " Answer: " + Answer + " Ready: " + Ready):
 )
)
